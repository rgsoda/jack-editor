[Desktop Entry]
Type=Application
Name=jack
GenericName=Text Editor
Comment=A terminal text editor, in a window when you want one
Exec=jack --gui %F
TryExec=jack
Icon=jack
Terminal=false
Categories=Utility;TextEditor;
Keywords=text;editor;vim;code;
MimeType=text/plain;text/markdown;text/x-rust;text/x-python;text/x-c;text/x-csrc;text/x-chdr;text/x-go;application/json;text/html;text/css;application/javascript;
StartupNotify=true
StartupWMClass=jack
